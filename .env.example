# --- Base de données ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://classmind:change-me@db:5432/classmind

# --- Domaine public servi par Caddy (localhost pour un essai local, TLS automatique sinon) ---
CLASSMIND_HOST=localhost
PUBLIC_URL=http://localhost:8080

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_ISSUER=http://localhost:8080/auth/realms/classmind
OIDC_AUDIENCE=classmind-api
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/classmind/protocol/openid-connect/certs

# --- OpenAI (seul service propriétaire ; la clé reste côté API) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Tarifs EUR / million de tokens du modèle choisi (suivi des coûts et plafond)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
LLM_DEFAULT_MONTHLY_CAP_EUR=20
